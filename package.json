{
  "name": "models-from-wb",
  "version": "0.1.1",
  "private": true,
  "description": "在 DeepSeek Harness 中使用本机 WorkBuddy 桌面端已登录的模型（DeepSeek / GLM / Kimi / MiniMax / 混元等）：零依赖本地桥 + 最小 dsh bundle 插件。根包即 dsh bundle：dsh「添加插件」填 github:mengbin92/models-from-wb 可直装。",
  "type": "module",
  "license": "MIT",
  "main": "./plugin/lib/index.js",
  "exports": {
    ".": "./plugin/lib/index.js",
    "./cordis.patch.yml": "./plugin/cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./plugin/locale/*.json",
    "./icon": "./plugin/icon.svg"
  },
  "files": [
    "plugin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./plugin/cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mengbin92/models-from-wb.git"
  },
  "homepage": "https://github.com/mengbin92/models-from-wb",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "workbuddy",
    "llm-provider",
    "openai-compatible"
  ]
}
